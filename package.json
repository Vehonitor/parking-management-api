{
  "name": "parking-management-api",
  "version": "1.0.0",
  "description": "Parking Management API",
  "scripts": {
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:preprod": "serverless deploy --stage preprod",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove",
    "logs": "serverless logs -f api -t"
  },
  "devDependencies": {
    "serverless": "^3.38.0",
    "serverless-domain-manager": "^8.0.0",
    "serverless-offline": "^13.3.0",
    "serverless-plugin-warmup": "^8.3.0",
    "serverless-python-requirements": "^6.1.0"
  }
}
